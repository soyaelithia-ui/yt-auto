{
  "version": 1,
  "defaults": {
    "fps": 30,
    "language": "es"
  },
  "lanes": [
    {
      "id": "moku-scp-shorts",
      "enabled": true,
      "channel": "moku",
      "story_type": "scp",
      "orientation": "vertical",
      "duration": { "min_sec": 60, "target_sec": 150, "max_sec": 180 },
      "words": { "min": 160, "max": 340, "recondense_max": 300 },
      "template": "shorts_creepypasta",
      "voice_rate": "+0%",
      "voice_profile": "scp_documentary_es",
      "cadence": { "min_gap_seconds": 300 },
      "sources": {
        "kind": "reddit",
        "subreddits": ["SCP", "SCPDeclassified", "nosleep"],
        "listing_categories": [["hot", "day"], ["top", "week"], ["new", "all"]],
        "limit_per_fetch": 25,
        "queue_target_pending": 25
      },
      "topic_filter": {
        "mode": "off",
        "keywords": ["scp", "anomal", "contención", "fundación"]
      },
      "multistory_collection": false,
      "visual_pipeline": "beats",
      "qa_profile": "short",
      "review_content_type": "short",
      "padding_themes": ["pasillos metálicos", "luz de emergencia roja", "contención de hormigón"],
      "background_audio": {
        "enabled": true,
        "volume": 0.04,
        "mode": "auto",
        "theme": "scp"
      }
    },
    {
      "id": "moku-horror-long",
      "enabled": true,
      "channel": "moku",
      "story_type": "horror",
      "orientation": "horizontal",
      "duration": { "min_sec": 600, "target_sec": 600, "max_sec": 1800 },
      "words": { "min": 2600, "max": null },
