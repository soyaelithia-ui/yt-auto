        "kind": "reddit",
        "subreddits": ["nosleep", "scarystories", "darktales", "libraryofshadows"],
        "limit_per_fetch": 25,
        "queue_target_pending": 25
      },
      "topic_filter": { "mode": "off" },
      "multistory_collection": true,
      "visual_pipeline": "director",
      "qa_profile": "longform",
      "review_content_type": "long_video",
      "padding_themes": ["bosques niebla", "casas abandonadas", "carreteras nocturnas"],
      "background_audio": {
        "enabled": true,
