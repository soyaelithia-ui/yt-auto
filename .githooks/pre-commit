#!/usr/bin/env bash
# .githooks/pre-commit - Deterministic anti-regression gate for yt-auto
# Delegates all invariant, anti-bloat, and secret validation to scripts/verify_integrity.py --staged (< 50ms).
#
# Enforced security & invariant policies:
# - Inspects git index: git diff --cached --name-only --diff-filter=ACM
# - Agent homedir protection: .codex, .claude, .gemini, .agents, .opencode, .cursor, .hermes
# - Secret filename rejection: .env (except .env.example), cookies\.json, secrets/
# - Production secret signatures:
#   AIzaSy[a-zA-Z0-9_-]{33}|GOCSPX-[a-zA-Z0-9_-]{28}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}
#   [0-9]{8,10}:[A-Za-z0-9_-]{35}|[0-9]{12}-[a-z0-9]{32}|-----BEGIN [A-Z ]*PRIVATE KEY-----
#   ya29\.[A-Za-z0-9_-]{50,}|AKIA[0-9A-Z]{16}
#   service_account and "private_key"
# - Safe text inspection: grep -I -E -q semantics evaluated via AST and regex without execution of staged code.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

PYTHON_BIN="python3"
if [ -x "$REPO_ROOT/.venv/bin/python3" ]; then
    PYTHON_BIN="$REPO_ROOT/.venv/bin/python3"
fi

exec "$PYTHON_BIN" "$REPO_ROOT/scripts/verify_integrity.py" --staged "$@"
