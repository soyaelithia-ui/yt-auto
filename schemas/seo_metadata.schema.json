{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeoMetadata",
  "description": "Canonical output contract for Agent 6 (SEO & Viral Metadata Optimizer)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "target_format": {
      "type": "string",
      "enum": ["short", "longform"]
    },
    "viral_title_options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 100
      }
    },
    "selected_title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "hashtags": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^#[A-Za-z0-9_]+$"
      }
    },
    "pinned_comment": {
      "type": "string",
      "minLength": 5
    },
    "thumbnail_concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "visual_layout": {
            "type": "string"
          },
          "big_headline": {
            "type": "string"
          },
          "color_palette": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "facial_expression": {
            "type": "string"
          }
        },
        "required": ["visual_layout", "big_headline", "color_palette"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "topic",
    "target_format",
    "viral_title_options",
    "selected_title",
    "description",
    "tags",
    "hashtags",
    "pinned_comment",
    "thumbnail_concepts"
  ],
  "additionalProperties": false
}
