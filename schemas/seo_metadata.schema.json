{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SeoMetadata",
  "description": "Canonical SEO metadata plus a delegated local AI thumbnail asset request; no baked cover text.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "target_format": {
      "type": "string",
      "enum": [
        "short",
        "longform"
      ]
    },
    "viral_title_options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 100
      }
    },
    "selected_title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "tags": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "hashtags": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^#[A-Za-z0-9_]+$"
      }
    },
    "pinned_comment": {
      "type": "string",
      "minLength": 5
    },
    "thumbnail_asset_request": {
      "type": "object",
      "properties": {
        "bank": {
          "type": "string",
          "const": "local_ai"
        },
        "archetype": {
          "type": "string",
          "minLength": 1
        },
        "focal_subject": {
          "type": "string",
          "minLength": 1
        },
        "color_palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "text_free": {
          "const": true
        }
      },
      "required": [
        "bank",
        "archetype",
        "focal_subject",
        "text_free"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "topic",
    "target_format",
    "viral_title_options",
    "selected_title",
    "description",
    "tags",
    "hashtags",
    "pinned_comment",
    "thumbnail_asset_request"
  ],
  "additionalProperties": false
}
