{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CinematicScript",
  "description": "Canonical output contract for Agent 1 (Cinematic Script Curator)",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "enum": ["2.0"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "channel_lane": {
          "type": "string",
          "minLength": 1
        },
        "target_format": {
          "type": "string",
          "enum": ["longform", "short"]
        },
        "total_word_count": {
          "type": "integer",
          "minimum": 1
        },
        "estimated_duration_sec": {
          "type": "number",
          "minimum": 1.0
        },
        "hook_summary": {
          "type": "string"
        },
        "tension_curve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        },
        "predictive_success_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "score_rationale": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "channel_lane",
        "target_format",
        "total_word_count",
        "estimated_duration_sec",
        "tension_curve"
      ],
      "additionalProperties": false
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "act_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "act_title": {
            "type": "string",
            "minLength": 1
          },
          "dramatic_role": {
            "type": "string",
            "enum": [
              "exposition_inception",
              "rising_action_dread",
              "climax_confrontation",
              "aftermath_revelation"
            ]
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "scene_id": {
                  "type": "string",
                  "pattern": "^scene_[0-9]{3}$"
                },
                "scene_index": {
                  "type": "integer",
                  "minimum": 1
                },
                "tension_level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "narration_text": {
                  "type": "string",
                  "minLength": 1
                },
                "word_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "estimated_duration_sec": {
                  "type": "number",
                  "minimum": 1.0
                },
                "environmental_mood": {
                  "type": "string",
                  "minLength": 1
                },
                "audio_pacing_cue": {
                  "type": "string",
                  "enum": [
                    "calm_slow",
                    "steady_dramatic",
                    "tense_accelerando",
                    "intense_urgent",
                    "whispered_grave"
                  ]
                },
                "transition_reason": {
                  "type": "string"
                }
              },
              "required": [
                "scene_id",
                "scene_index",
                "tension_level",
                "narration_text",
                "word_count",
                "estimated_duration_sec",
                "environmental_mood"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "act_number",
          "act_title",
          "dramatic_role",
          "scenes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "metadata",
    "acts"
  ],
  "additionalProperties": false
}
