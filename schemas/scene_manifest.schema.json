{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneManifestV2",
  "description": "Canonical manifest for local video assets and stream-copy composition; no generated frames or runtime graphic layers.",
  "type": "object",
  "required": [
    "manifest_version",
    "story_id",
    "lane_id",
    "channel_name",
    "resolution",
    "fps",
    "total_duration_sec",
    "audio_tracks",
    "safe_area",
    "scenes"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": [
        "2.0",
        "2.1",
        "2.0.0"
      ]
    },
    "story_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "lane_id": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 640
      },
      "minItems": 2,
      "maxItems": 2
    },
    "fps": {
      "type": "integer",
      "enum": [
        24,
        25,
        30,
        50,
        60
      ]
    },
    "total_duration_sec": {
      "type": "number",
      "minimum": 0.1
    },
    "color_profile": {
      "type": "object",
      "properties": {
        "color_space": {
          "type": "string",
          "default": "bt709"
        },
        "color_primaries": {
          "type": "string",
          "default": "bt709"
        },
        "color_trc": {
          "type": "string",
          "default": "bt709"
        },
        "pixel_format": {
          "type": "string",
          "enum": [
            "yuv420p",
            "yuv420p10le"
          ],
          "default": "yuv420p"
        }
      },
      "additionalProperties": true
    },
    "audio_tracks": {
      "type": "object",
      "required": [
        "narration_path"
      ],
      "properties": {
        "narration_path": {
          "type": "string",
          "minLength": 1
        },
        "music_path": {
          "type": "string"
        },
        "music_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.12
        },
        "ducking": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "threshold": {
              "type": "number",
              "default": 0.035
            },
            "ratio": {
              "type": "number",
              "default": 8.0
            },
            "attack_ms": {
              "type": "number",
              "default": 20.0
            },
            "release_ms": {
              "type": "number",
              "default": 350.0
            },
            "target_lufs": {
              "type": "number",
              "default": -14.0
            },
            "max_tp": {
              "type": "number",
              "default": -1.5
            },
            "lra": {
              "type": "number",
              "default": 11.0
            }
          },
          "additionalProperties": true
        },
        "sfx_cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sfx_path",
              "timestamp_sec",
              "volume"
            ],
            "properties": {
              "sfx_id": {
                "type": "string"
              },
              "sfx_path": {
                "type": "string"
              },
              "timestamp_sec": {
                "type": "number",
                "minimum": 0.0
              },
              "volume": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "pan": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "safe_area": {
      "type": "object",
      "required": [
        "margin_top",
        "margin_bottom",
        "margin_left",
        "margin_right"
      ],
      "properties": {
        "margin_top": {
          "type": "integer",
          "minimum": 0
        },
        "margin_bottom": {
          "type": "integer",
          "minimum": 0
        },
        "margin_left": {
          "type": "integer",
          "minimum": 0
        },
        "margin_right": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_index",
          "scene_id",
          "start_sec",
          "duration_sec",
          "tension_level",
          "engine_type"
        ],
        "properties": {
          "scene_index": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string"
          },
          "environment_name": {
            "type": "string"
          },
          "start_sec": {
            "type": "number",
            "minimum": 0.0
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0.1
          },
          "tension_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "transition_out": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "crossfade",
                  "volumetric_fade",
                  "depth_dissolve",
                  "glitch_cut",
                  "cut",
                  "fade_to_black",
                  "fade"
                ],
                "default": "crossfade"
              },
              "duration_sec": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 3.0,
                "default": 0.8
              }
            },
            "additionalProperties": true
          },
          "engine_type": {
            "type": "string",
            "enum": [
              "catalog_loop"
            ]
          },
          "image_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "asset_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "not": {
          "anyOf": [
            {
              "required": [
                "procedural_config"
              ]
            },
            {
              "required": [
                "uniforms"
              ]
            }
          ]
        }
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0
          },
          "end": {
            "type": "number",
            "minimum": 0.0
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "stamp_text": {
          "type": "string"
        },
        "channel_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "hook_text": {
      "type": "string"
    },
    "thumbnail_candidate_timestamp": {
      "type": "number",
      "minimum": 0.0
    },
    "cache_keys": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
