{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SceneManifestV2",
  "description": "Canonical Visual & Audio Scene Manifest Contract for Dual-Engine Video Rendering Pipeline",
  "type": "object",
  "required": [
    "manifest_version",
    "story_id",
    "lane_id",
    "channel_name",
    "resolution",
    "fps",
    "total_duration_sec",
    "audio_tracks",
    "safe_area",
    "scenes"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "enum": ["2.0", "2.1", "2.0.0"]
    },
    "story_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "lane_id": {
      "type": "string"
    },
    "channel_name": {
      "type": "string"
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 640
      },
      "minItems": 2,
      "maxItems": 2
    },
    "fps": {
      "type": "integer",
      "enum": [24, 25, 30, 50, 60]
    },
    "total_duration_sec": {
      "type": "number",
      "minimum": 0.1
    },
    "color_profile": {
      "type": "object",
      "properties": {
        "color_space": {
          "type": "string",
          "default": "bt709"
        },
        "color_primaries": {
          "type": "string",
          "default": "bt709"
        },
        "color_trc": {
          "type": "string",
          "default": "bt709"
        },
        "pixel_format": {
          "type": "string",
          "enum": ["yuv420p", "yuv420p10le"],
          "default": "yuv420p"
        }
      },
      "additionalProperties": true
    },
    "audio_tracks": {
      "type": "object",
      "required": ["narration_path"],
      "properties": {
        "narration_path": {
          "type": "string",
          "minLength": 1
        },
        "music_path": {
          "type": "string"
        },
        "music_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.12
        },
        "ducking": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "threshold": {
              "type": "number",
              "default": 0.035
            },
            "ratio": {
              "type": "number",
              "default": 8.0
            },
            "attack_ms": {
              "type": "number",
              "default": 20.0
            },
            "release_ms": {
              "type": "number",
              "default": 350.0
            },
            "target_lufs": {
              "type": "number",
              "default": -14.0
            },
            "max_tp": {
              "type": "number",
              "default": -1.5
            },
            "lra": {
              "type": "number",
              "default": 11.0
            }
          },
          "additionalProperties": true
        },
        "sfx_cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["sfx_path", "timestamp_sec", "volume"],
            "properties": {
              "sfx_id": {
                "type": "string"
              },
              "sfx_path": {
                "type": "string"
              },
              "timestamp_sec": {
                "type": "number",
                "minimum": 0.0
              },
              "volume": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "pan": {
                "type": "number",
                "minimum": -1.0,
                "maximum": 1.0,
                "default": 0.0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "safe_area": {
      "type": "object",
      "required": ["margin_top", "margin_bottom", "margin_left", "margin_right"],
      "properties": {
        "margin_top": {
          "type": "integer",
          "minimum": 0
        },
        "margin_bottom": {
          "type": "integer",
          "minimum": 0
        },
        "margin_left": {
          "type": "integer",
          "minimum": 0
        },
        "margin_right": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_index",
          "scene_id",
          "start_sec",
          "duration_sec",
          "tension_level",
          "engine_type"
        ],
        "properties": {
          "scene_index": {
            "type": "integer",
            "minimum": 1
          },
          "scene_id": {
            "type": "string"
          },
          "environment_name": {
            "type": "string"
          },
          "start_sec": {
            "type": "number",
            "minimum": 0.0
          },
          "duration_sec": {
            "type": "number",
            "minimum": 0.1
          },
          "tension_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "engine_type": {
            "type": "string",
            "enum": [
              "hybrid_cinematic_ai",
              "pure_procedural_webgl",
              "procedural_canvas2d"
            ]
          },
          "hybrid_ai_config": {
            "type": "object",
            "properties": {
              "background_image_path": {
                "type": ["string", "null"]
              },
              "depth_map_path": {
                "type": ["string", "null"]
              },
              "prompt_used": {
                "type": ["string", "null"]
              },
              "seed": {
                "type": "integer"
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["layer_id", "asset_path", "z_depth"],
                  "properties": {
                    "layer_id": {
                      "type": "string"
                    },
                    "asset_path": {
                      "type": "string"
                    },
                    "z_depth": {
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0
                    },
                    "blend_mode": {
                      "type": "string",
                      "enum": ["normal", "screen", "multiply", "overlay", "add"],
                      "default": "normal"
                    },
                    "opacity": {
                      "type": "number",
                      "minimum": 0.0,
                      "maximum": 1.0,
                      "default": 1.0
                    }
                  },
                  "additionalProperties": true
                }
              },
              "camera_motion": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "ken_burns_3d",
                      "parallax_drift",
                      "orbital_pan",
                      "zoom_in",
                      "zoom_out",
                      "pan_left",
                      "pan_right",
                      "static"
                    ],
                    "default": "ken_burns_3d"
                  },
                  "start_zoom": {
                    "type": "number",
                    "default": 1.0
                  },
                  "end_zoom": {
                    "type": "number",
                    "default": 1.08
                  },
                  "pan_direction": {
                    "type": "string",
                    "enum": [
                      "center_to_top",
                      "center_to_bottom",
                      "left_to_right",
                      "right_to_left",
                      "static"
                    ],
                    "default": "center_to_top"
                  },
                  "easing": {
                    "type": "string",
                    "enum": ["linear", "ease_in_out", "cubic_bezier"],
                    "default": "cubic_bezier"
                  },
                  "parallax_intensity": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0,
                    "default": 0.15
                  }
                },
                "additionalProperties": true
              },
              "lighting": {
                "type": "object",
                "properties": {
                  "volumetric_rays": {
                    "type": "boolean",
                    "default": false
                  },
                  "light_source_pos": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "intensity": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0,
                    "default": 0.3
                  },
                  "flicker_frequency": {
                    "type": "number",
                    "minimum": 0.0,
                    "default": 0.0
                  },
                  "color_tint": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "default": "#ffffff"
                  }
                },
                "additionalProperties": true
              },
              "particles": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "dust_motes",
                      "ember_sparks",
                      "fog_mist",
                      "spores",
                      "rain_streaks",
                      "none"
                    ],
                    "default": "none"
                  },
                  "density": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500,
                    "default": 40
                  },
                  "velocity": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 5.0,
                    "default": 1.0
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "default": "#ffffff"
                  },
                  "opacity": {
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0,
                    "default": 0.4
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "procedural_config": {
            "type": "object",
            "properties": {
              "template_name": {
                "type": "string"
              },
              "seed": {
                "type": "integer",
                "default": 42
              },
              "palette": {
                "type": "object",
                "properties": {
                  "base_dark": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "mid_tone": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "additionalProperties": true
              },
              "uniforms": {
                "type": "object",
                "properties": {
                  "u_noise_scale": {
                    "type": "number",
                    "default": 1.0
                  },
                  "u_speed": {
                    "type": "number",
                    "default": 1.0
                  },
                  "u_distortion": {
                    "type": "number",
                    "default": 0.5
                  },
                  "u_glow_intensity": {
                    "type": "number",
                    "default": 0.8
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "transition_out": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "crossfade",
                  "volumetric_fade",
                  "depth_dissolve",
                  "glitch_cut",
                  "cut",
                  "fade_to_black",
                  "fade"
                ],
                "default": "crossfade"
              },
              "duration_sec": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 3.0,
                "default": 0.8
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end", "text"],
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0.0
          },
          "end": {
            "type": "number",
            "minimum": 0.0
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "stamp_text": {
          "type": "string"
        },
        "channel_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "hook_text": {
      "type": "string"
    },
    "thumbnail_candidate_timestamp": {
      "type": "number",
      "minimum": 0.0
    },
    "cache_keys": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
