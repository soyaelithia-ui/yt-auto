{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ ! -f \".agents/skills/impeccable/scripts/hook.mjs\" ] || node \".agents/skills/impeccable/scripts/hook.mjs\"",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/hook.mjs\" (node \".agents/skills/impeccable/scripts/hook.mjs\" \u0026 exit /b)",
            "statusMessage": "Checking UI changes",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|apply_patch"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gentle-ai skill-registry refresh --quiet --no-gitignore --cwd \"$PWD\" || true",
            "statusMessage": "Refreshing skill registry",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ ! -f \".agents/skills/impeccable/scripts/hook.mjs\" ] || node \".agents/skills/impeccable/scripts/hook.mjs\"",
            "commandWindows": "if exist \".agents/skills/impeccable/scripts/hook.mjs\" (node \".agents/skills/impeccable/scripts/hook.mjs\" \u0026 exit /b)",
            "statusMessage": "Design deep pass",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
