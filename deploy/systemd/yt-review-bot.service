[Unit]
Description=YTAuto Telegram Review Bot (HITL gate + admin control)
After=network.target

[Service]
Type=simple
User=moku
Group=developers
# Canonical VPS deploy root: /srv/projects/yt-auto
# systemd no expande variables en WorkingDirectory=/ExecStart= (ruta del binario);
# esos paths deben quedar absolutos y alineados con YT_AUTO_ROOT.
# Override en otro host: systemctl edit yt-review-bot.service y redefinir
# Environment=YT_AUTO_ROOT=..., WorkingDirectory=... y ExecStart=...
EnvironmentFile=-/srv/projects/yt-auto/.env
Environment=YT_AUTO_ROOT=/srv/projects/yt-auto
WorkingDirectory=/srv/projects/yt-auto
Environment=YT_PROFILE=prod
Environment=ENABLE_TELEGRAM_CALLBACK_POLLING=1
ExecStart=/srv/projects/yt-auto/.venv/bin/python deploy/tmux_review_bot.py
# Refuerzo de recursos y anti-doble-polling (auditoría 2026-08-24)
# Este unit es el ÚNICO poller de Telegram autorizado; los daemons lo desactivan.
Nice=10
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=1G
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
