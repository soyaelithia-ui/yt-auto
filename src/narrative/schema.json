{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CosmicScriptContract",
  "type": "object",
  "required": [
    "title",
    "format",
    "telemetry_header",
    "audio",
    "scenes"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Título clasificado del expediente o registro de telemetría."
    },
    "format": {
      "type": "string",
      "enum": ["SHORT_VERTICAL", "LONG_HORIZONTAL"],
      "description": "Formato de salida del video: SHORT_VERTICAL (1080x1920) o LONG_HORIZONTAL (1920x1080)."
    },
    "telemetry_header": {
      "type": "string",
      "description": "Cabecera de telemetría ISO y nivel de seguridad (ej. REC [●] YYYY-MM-DD HH:mm:ss UTC // LVL-5 RESTRICTED)."
    },
    "audio": {
      "type": "object",
      "required": ["voice_text", "voice_preset", "drone_base_freq_hz", "sfx_timeline"],
      "properties": {
        "voice_text": {
          "type": "string",
          "description": "Texto de la locución narrativa con pausas marcadas mediante puntos suspensivos."
        },
        "voice_preset": {
          "type": "string",
          "enum": ["intercom_bunker", "hydrophone_radio", "blackbox_tape"],
          "description": "Preset de procesamiento vocal de interfono/transmisión."
        },
        "drone_base_freq_hz": {
          "type": "number",
          "minimum": 20.0,
          "maximum": 120.0,
          "description": "Frecuencia fundamental en Hz para el sub-drone procedural."
        },
        "sfx_timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["time_sec", "sfx_id"],
            "properties": {
              "time_sec": { "type": "number", "minimum": 0.0 },
              "sfx_id": {
                "type": "string",
                "enum": [
                  "ptt_squelch",
                  "sonar_ping_deep_reverb",
                  "hull_stress_metal_groan",
                  "singularity_glitch_burst",
                  "geiger_clicks",
                  "static_burst"
                ]
              },
              "volume": { "type": "number", "minimum": 0.0, "maximum": 2.0, "default": 1.0 }
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_sec", "end_sec", "hud_status"],
        "properties": {
          "start_sec": { "type": "number", "minimum": 0.0 },
          "end_sec": { "type": "number", "minimum": 0.0 },
          "visual_asset": { "type": "string" },
          "tension_level": { "type": "integer", "minimum": 1, "maximum": 5 },
          "hud_status": { "type": "string" },
          "palette": { "type": "object" },
          "camera_transform": { "type": "object" }
        }
      }
    },
    "loop_continuity_phrase": {
      "type": "string",
      "description": "Frase de enganche sintáctico para bucle infinito continuo en Shorts."
    }
  }
}
