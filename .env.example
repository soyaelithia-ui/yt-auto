# Environment configuration for yt-auto
# Copy this file to .env and fill in your real values.
# NEVER commit .env to the repository.
#
# Template policy (aligned with docs/CONFIGURACION_SECRETOS.md + SECURITY.md):
# - Secret values stay EMPTY: API keys, tokens, passwords, client secrets.
# - Non-secret defaults are intentional: flags, timeouts, presets, and relative
#   *_PATH / *_FILE / *_DIR placeholders under secrets/ (not live credentials).
# - Enforced by tests/unit/test_security_policies.py::test_env_example_contains_no_real_secrets
# - Auth uses GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET (no GOOGLE_CLIENT_SECRETS_FILE env).


# ===========================================================================
# 0. Directories & persistence (optional; profile defaults apply if unset)
# ===========================================================================
# Relative paths are non-secret placeholders. Override when needed.
YOUTUBE_AUTOMATION_DB=data/shorts_queue.db
VIDEO_REVIEW_DB_PATH=data/review_state.db
WORK_ROOT=work
ARTIFACT_ROOT=artifacts
SECRETS_DIR=secrets

# ===========================================================================
# 0b. Antigravity agents CLI (non-secret paths/flags; see docs/CONFIGURACION_SECRETOS.md)
# ===========================================================================
# Host default; Docker/compose often set BOT_HOME=/home/appuser.
BOT_HOME=.bot_home
# Host default; Docker image sets /home/appuser/.gemini/antigravity-cli via compose.
ANTIGRAVITY_AGENTS_APP_DATA_DIR=.bot_home/.gemini/antigravity-cli
# Per-instance override: ANTIGRAVITY_AGENTS_APP_DATA_DIR_<INSTANCE_ID>
# e.g. PIPELINE_CREATIVE → .bot_home_pipeline_creative/.gemini/antigravity-cli when unset.
# AGY_BIN: Docker default inside the image; override on host if `agy` is elsewhere.
AGY_BIN=/usr/local/bin/agy
# Model for Antigravity agents (base_agent). Falls back to GEMINI_MODEL, then this default.
AGY_MODEL=gemini-3.7-flash
# REST/llm.py model when AGY_MODEL unset; keep aligned with agents default.
GEMINI_MODEL=gemini-3.7-flash
AGY_CREDITS_DISABLED_CONFIRMED=0
# Opt-in harness / native SDK (seo_optimizer, image_auditor, base_agent). Default off.
USE_AGENT_HARNESS=0
USE_ANTIGRAVITY_SDK=0

# ===========================================================================
# 1. Google OAuth 2.0 Client (Desktop App) — env ID/secret only
# ===========================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================================================
# 2. Google Cloud API Key (YouTube Data API v3 / Gemini REST)
# ===========================================================================
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# ===========================================================================
# 3. Google Drive & GCP Service Account (validate_runtime_config + compose)
# ===========================================================================
DRIVE_KEY_PATH="secrets/drive_key.json"
DRIVE_USE_GCLOUD=0
# Preflight require_drive: DRIVE_FOLDER_ID + DRIVE_APPROVED_VIDEO_FOLDER_ID
DRIVE_FOLDER_ID=
DRIVE_ROOT_FOLDER_ID=
DRIVE_APPROVED_FOLDER_ID=
DRIVE_APPROVED_VIDEO_FOLDER_ID=
DRIVE_APPROVED_COVER_FOLDER_ID=
DRIVE_METADATA_FOLDER_ID=
DRIVE_PUBLISHED_FOLDER_ID=
DRIVE_REJECTED_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=

# ===========================================================================
# 4. YouTube Channels & OAuth Tokens
# ===========================================================================
# Active lane key (optional). Empty = profile default. Read by src/config.py /
# channel_profile.py (e.g. moku | aelithia).
CHANNEL_KEY=
# Handles / identity overrides (optional). Empty = use config/channels/*.json
# (ChannelProfile / src/config.py). Generic CHANNEL_* apply to the active lane.
CHANNEL_HANDLE=
CHANNEL_URL=
CHANNEL_NAME=
MOKU_HANDLE=
AELITHIA_HANDLE=

MOKU_YOUTUBE_CHANNEL_ID=
MOKU_YOUTUBE_TOKEN_PATH="secrets/youtube_token.json"
MOKU_COOKIES_PATH="secrets/decrypted_cookies.json"

AELITHIA_YOUTUBE_CHANNEL_ID=
AELITHIA_YOUTUBE_TOKEN_PATH="secrets/youtube_token_aelithia.json"
AELITHIA_COOKIES_PATH="secrets/cookies_channel2.json"

# ===========================================================================
# 5. Telegram Review Bot (+ local Bot API sidecar)
# ===========================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_LOCAL=true
# Local Bot API (docker service) when TELEGRAM_LOCAL=true; cloud default is https://api.telegram.org
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
# Zero-copy file:/// uploads when talking to a local Bot API server
TELEGRAM_USE_LOCAL_FILES=1
TELEGRAM_REQUEST_TIMEOUT_SECONDS=60
TELEGRAM_MEDIA_TIMEOUT_SECONDS=1800
TELEGRAM_MAX_FILE_SIZE_MB=2000
# Sidecar aiogram/telegram-bot-api (compose service) — empty secrets only
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ===========================================================================
# 6. Media render policy (SSOT PDF v2.4.0)
# ===========================================================================
# Production hot path: FFmpeg. ENABLE_NATIVE_PROCEDURAL default MUST stay 0.
ENABLE_NATIVE_PROCEDURAL=0
RENDER_CRF=21
RENDER_PRESET=veryfast
FFMPEG_THREADS=4
DIRECTOR_SINGLE_PASS=1
DIRECTOR_XFADE=0
MULTIACT_XFADE=1

# --- Auto-approve / autopilot (HITL), not a secrets bypass ---
# Defaults match docker-compose.yml ("0"). Opt-in does NOT skip preflight/YouTube gate.
AUTO_APPROVE=0
ENABLE_AUTO_PUBLISH_SWEEP=0
AUTO_PUBLISH_TIMEOUT_HOURS=24
