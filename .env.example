# Environment configuration for yt-auto
# Copy this file to .env and fill in your real values.
# NEVER commit .env to the repository.

# ===========================================================================
# 1. Google OAuth 2.0 Client (Desktop App)
# ===========================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS_FILE="secrets/client_secret.json"

# ===========================================================================
# 2. Google Cloud API Key (YouTube Data API v3 / Gemini REST)
# ===========================================================================
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# ===========================================================================
# 3. Google Drive & GCP Service Account
# ===========================================================================
DRIVE_KEY_PATH="secrets/drive_key.json"
DRIVE_USE_GCLOUD=0
DRIVE_ROOT_FOLDER_ID=
DRIVE_APPROVED_FOLDER_ID=

# ===========================================================================
# 4. YouTube Channels & OAuth Tokens
# ===========================================================================
MOKU_YOUTUBE_CHANNEL_ID=
MOKU_YOUTUBE_TOKEN_PATH="secrets/youtube_token.json"
MOKU_COOKIES_PATH="secrets/decrypted_cookies.json"

AELITHIA_YOUTUBE_CHANNEL_ID=
AELITHIA_YOUTUBE_TOKEN_PATH="secrets/youtube_token_aelithia.json"
AELITHIA_COOKIES_PATH="secrets/cookies_channel2.json"

# ===========================================================================
# 5. Telegram Review Bot
# ===========================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_LOCAL=true

# ===========================================================================
# 6. Media render policy (SSOT PDF v2.4.0)
# ===========================================================================
# Production hot path: FFmpeg (stream-copy / zoompan / xfade / libass / EBU R128).
# QUARANTINED: src/media/_legacy/native_procedural (wgpu/Lavapipe) is NOT SSOT.
# Production = FFmpeg audiovisual + Pillow thumbs. Default MUST stay 0.
# Set to 1 only for explicit local experiments (requires wgpu installed).
ENABLE_NATIVE_PROCEDURAL=0

# Low-CPU encode knobs (aligned with docker-compose.yml). Prefer stream-copy for
# horizontal beats; when re-encode is required use veryfast + CRF≤21 (not slow,
# not ultrafast on final YouTube delivers). Pillow/rawvideo loops stay opt-in:
# FORCE_PILLOW_SUBTITLES=0 / FORCE_PILLOW_HYBRID_FRAMES=0 (default).
RENDER_CRF=21
RENDER_PRESET=veryfast
FFMPEG_THREADS=4

# Director assembly (low CPU): skip per-scene re-encodes when catalog loops resolve.
# Default on. Set 0 to force legacy multi-pass (per-scene encode → concat → master).
DIRECTOR_SINGLE_PASS=1
# Real FFmpeg xfade in MultiSceneCompositor (shortens timeline). Default off for
# narration-synced manifests.
DIRECTOR_XFADE=0
# MultiActVideoRenderer xfade (shortens timeline). Default on to match docs; set 0
# for concat without shrink. Callers must pass calculate_xfade_duration as total_duration.
MULTIACT_XFADE=1
