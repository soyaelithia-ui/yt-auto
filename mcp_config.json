{
  "mcpServers": {
    "yt-auto": {
      "command": ".venv/bin/python3",
      "args": [
        "-m",
        "src.mcp"
      ],
      "env": {
        "PYTHONPATH": ".",
        "YT_PROFILE": "cli"
      }
    },
    "engram": {
      "command": "engram",
      "args": [
        "mcp",
        "--tools=agent"
      ]
    }
  }
}
